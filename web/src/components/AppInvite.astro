---
/**
 * The Android invitation.
 *
 * The footer keeps one editorial line — "Your home screen is missing the sky."
 * — with a quiet "See the app" link. That link opens a centred, accessible
 * modal with a real preview of today's APOD inside a tilted phone, the reason
 * to install the app and one focused download button. The image is fetched
 * only when the modal is first opened; without JavaScript the link still goes
 * to the release page.
 */
import { SITE } from '../lib/site';
---

<div class="app-invite" data-app-invite>
  <p class="app-invite__eyebrow">Mohakash for Android</p>
  <p class="app-invite__title">Your home screen is missing the sky.</p>
  <a
    class="app-invite__trigger"
    href={SITE.androidReleaseUrl}
    data-app-invite-open
    aria-haspopup="dialog"
    aria-controls="app-invite-dialog"
  >
    See the app
    <i class="icon ri-arrow-right-line" aria-hidden="true"></i>
  </a>
</div>

<dialog
  class="app-invite-dialog"
  id="app-invite-dialog"
  aria-labelledby="app-invite-dialog-title"
  aria-describedby="app-invite-dialog-text"
>
  <button
    class="app-invite-dialog__close"
    type="button"
    data-app-invite-close
    aria-label="Close"
  >
    <i class="icon ri-close-line" aria-hidden="true"></i>
  </button>

  <div class="app-invite-dialog__content">
    <div class="app-invite-dialog__visual" aria-hidden="true">
      <div class="app-invite__phone">
        <div class="app-invite__screen">
          <img class="app-invite__image" alt="" loading="lazy" decoding="async" hidden />
          <span class="app-invite__date" data-app-invite-date></span>
        </div>
      </div>
    </div>

    <div class="app-invite-dialog__copy">
      <p class="app-invite-dialog__eyebrow">Mohakash for Android</p>
      <h2 class="app-invite-dialog__title" id="app-invite-dialog-title">
        The website is the reading room. The app is the wallpaper.
      </h2>
      <p class="app-invite-dialog__text" id="app-invite-dialog-text">
        Each day's picture becomes a live wallpaper and refreshes itself in the background. The
        full archive stays with you, and there is no account, no advertising and no tracking.
      </p>
      <a class="btn btn--primary app-invite-dialog__download" href={SITE.androidApkUrl}>
        <i class="icon ri-download-line" aria-hidden="true"></i>
        Download for Android
      </a>
      <p class="app-invite-dialog__meta">Android 7.0+ · direct APK · free and open source</p>
    </div>
  </div>
</dialog>

<script>
  import { fetchLatestImage } from '../lib/api';
  import { formatDateShort } from '../lib/format';

  const trigger = document.querySelector<HTMLAnchorElement>('[data-app-invite-open]');
  const dialog = document.querySelector<HTMLDialogElement>('#app-invite-dialog');
  const close = dialog?.querySelector<HTMLButtonElement>('[data-app-invite-close]') ?? null;

  if (trigger && dialog) {
    let preview: Promise<void> | null = null;

    /** The preview image is only requested when the modal is first opened. */
    function loadPreview(): Promise<void> {
      if (preview) return preview;
      preview = fetchLatestImage()
        .then((record) => {
          const src = record.image_url ?? record.hd_image_url ?? record.thumbnail_url;
          if (!src) return;
          const image = dialog?.querySelector<HTMLImageElement>('.app-invite__image');
          const label = dialog?.querySelector<HTMLElement>('[data-app-invite-date]');
          if (image) {
            image.src = src;
            image.hidden = false;
          }
          if (label) label.textContent = formatDateShort(record.date);
        })
        .catch(() => {
          // The copy still works; the phone keeps its neutral gradient.
        });
      return preview;
    }

    trigger.addEventListener('click', (event) => {
      // Keep modified clicks as normal links (open the release page in a tab).
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
        return;
      }
      event.preventDefault();
      void loadPreview();
      dialog.showModal();
    });

    close?.addEventListener('click', () => dialog.close());

    // Clicking the backdrop (the dialog box itself) dismisses the modal.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('close', () => {
      // Return focus to the trigger once the native dialog has fully closed.
      window.setTimeout(() => trigger.focus(), 0);
    });
  }
</script>

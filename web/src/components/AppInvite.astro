---
/**
 * A quiet invitation to the Android app.
 *
 * It is deliberately part of the footer rather than a modal or an automatic
 * pop-up: one sentence about what the app adds (live wallpaper, automatic
 * updates, no tracking) and one plain link. No countdowns, no bright banner.
 */
import { SITE } from '../lib/site';
---

<a class="site-footer__app" href={SITE.androidReleaseUrl}>
  <i class="icon ri-smartphone-line" aria-hidden="true"></i>
  <span class="site-footer__app-copy">
    <span class="site-footer__app-title">Mohakash for Android</span>
    <span class="site-footer__app-text site-footer__app-text--long">
      The daily picture as a live wallpaper, updated automatically. Free and open source, no ads
      or tracking.
    </span>
    <span class="site-footer__app-text site-footer__app-text--short">
      Live wallpaper, updated daily.
    </span>
  </span>
  <span class="site-footer__app-cta">
    Get the app <i class="icon ri-arrow-right-line" aria-hidden="true"></i>
  </span>
</a>

---
/**
 * Banner — `surface-strong`, 12px radius, one sentence and one action.
 * Used for the "showing a saved copy" state.
 *
 * The banner is rendered by the server; the runtime script fills the message
 * and wires the action (see `applyBanner` in `src/lib/dom.ts`).
 */
import Button from './Button.astro';

interface Props {
  id?: string;
  /** Label of the action button. */
  actionLabel?: string;
  class?: string;
}

const { id, actionLabel = 'Retry', class: className } = Astro.props;
---

<div class:list={['banner', className]} role="status" id={id} hidden>
  <p class="banner__message"></p>
  <Button label={actionLabel} variant="text" class="banner__action" />
</div>

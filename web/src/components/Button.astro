---
/**
 * Button — primary, secondary or text.
 * Renders a real `<a>` when `href` is given, a real `<button>` otherwise.
 */
interface Props {
  label: string;
  href?: string;
  variant?: 'primary' | 'secondary' | 'text';
  type?: 'button' | 'submit';
  /** Open the link in a new tab (external resources). */
  external?: boolean;
  id?: string;
  ariaLabel?: string;
  class?: string;
}

const {
  label,
  href,
  variant = 'secondary',
  type = 'button',
  external = false,
  id,
  ariaLabel,
  class: className,
} = Astro.props;
---

{
  href ? (
    <a
      class:list={['btn', `btn--${variant}`, className]}
      href={href}
      id={id}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
      aria-label={ariaLabel}
    >
      {label}
    </a>
  ) : (
    <button
      class:list={['btn', `btn--${variant}`, className]}
      type={type}
      id={id}
      aria-label={ariaLabel}
    >
      {label}
    </button>
  )
}

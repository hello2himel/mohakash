---
/**
 * Site footer — the rights note on the left, the secondary links on the right.
 */
import { NOT_AFFILIATED } from '../lib/site';
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__note">{NOT_AFFILIATED}</p>
    <nav class="site-footer__links" aria-label="Footer">
      <a href="/api">API docs</a>
      <a href="/rights">Content rights</a>
      <a href="/feed.xml">RSS</a>
    </nav>
  </div>
</footer>

<script>
  // The menu copy of the "Hide videos" switch is kept in sync with the header
  // and toolbar copies through the shared custom event (wired in SiteHeader).
  const mobileToggle = document.getElementById('mobile-hide-videos') as HTMLInputElement | null;

  if (mobileToggle) {
    window.addEventListener('mohakash:hide-videos-changed', (event) => {
      const value = (event as CustomEvent).detail?.value;
      if (typeof value === 'boolean') mobileToggle.checked = value;
    });
  }
</script>

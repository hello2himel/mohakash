---
/**
 * Image frame — `surface` fill, 1px border, 12px radius and a fixed aspect
 * ratio. A frame without a picture stays a neutral surface (no broken-image
 * icon). Video entries get a poster frame with a play glyph and a chip.
 *
 * The frame is rendered by the server; the runtime script fills the picture,
 * the chip and the glyph in (see `applyPresentation` in `src/lib/dom.ts`).
 */
interface Props {
  /** `hero` is 16/9 (web), `thumb` and `list` are 4/3. */
  ratio?: 'hero' | 'thumb' | 'list';
  id?: string;
  /** Text shown while there is no picture. */
  label?: string;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const { ratio = 'hero', id, label = 'Image not available', loading = 'lazy', class: className } = Astro.props;
---

<div class:list={['media-frame', `media-frame--${ratio}`, className]} id={id}>
  <img class="media-frame__img" alt="" decoding="async" loading={loading} hidden />
  <p class="media-frame__label">{label}</p>
  <span class="media-frame__chip" hidden></span>
  <div class="media-frame__glyph" hidden>
    <i class="icon ri-play-circle-line" aria-hidden="true"></i>
  </div>
</div>

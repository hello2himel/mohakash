---
/**
 * Icon button — 48×48, 24px stroke icon. Always carries an accessible name.
 */
interface Props {
  /** Accessible name. Required: the icon itself is decorative. */
  label: string;
  id?: string;
  class?: string;
  /** Icon variant. */
  icon?: 'menu' | 'close';
  pressed?: boolean;
  expanded?: boolean;
}

const { label, id, class: className, icon = 'menu', pressed, expanded } = Astro.props;
---

<button
  class:list={['icon-btn', className]}
  type="button"
  id={id}
  aria-label={label}
  aria-haspopup={icon === 'menu' ? 'dialog' : undefined}
  aria-expanded={expanded}
  aria-pressed={pressed}
>
  {
    icon === 'menu' ? (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    ) : (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    )
  }
</button>

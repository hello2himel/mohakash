---
/**
 * Icon button — 48×48, 24px stroke icon. Always carries an accessible name.
 */
interface Props {
  /** Accessible name. Required: the icon itself is decorative. */
  label: string;
  id?: string;
  class?: string;
  /** Icon variant. */
  icon?: 'menu' | 'close';
  pressed?: boolean;
  expanded?: boolean;
}

const { label, id, class: className, icon = 'menu', pressed, expanded } = Astro.props;
---

<button
  class:list={['icon-btn', className]}
  type="button"
  id={id}
  aria-label={label}
  aria-haspopup={icon === 'menu' ? 'dialog' : undefined}
  aria-expanded={expanded}
  aria-pressed={pressed}
>
  {
    icon === 'menu' ? (
      <i class="icon ri-menu-line" aria-hidden="true"></i>
    ) : (
      <i class="icon ri-close-line" aria-hidden="true"></i>
    )
  }
</button>

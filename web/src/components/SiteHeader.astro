---
/**
 * Site header — wordmark on the left, main navigation on the right.
 * Below 600px the navigation collapses into the full-screen menu button.
 */
import IconButton from './IconButton.astro';
import MobileMenu from './MobileMenu.astro';
import { NAV_LINKS, SITE } from '../lib/site';

interface Props {
  /** Current path, used to mark the active navigation item. */
  current: string;
}

const { current } = Astro.props;
const isCurrent = (href: string) =>
  href === '/' ? current === '/' : current === '/' + href || current.startsWith(href + '/');
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="wordmark" href="/">{SITE.name}</a>

    <nav class="site-nav" aria-label="Main">
      {
        NAV_LINKS.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <IconButton
      label="Open menu"
      icon="menu"
      id="menu-button"
      class="site-header__menu-button"
      expanded={false}
    />
  </div>
</header>

<MobileMenu current={current} />

<script>
  const KEY = 'mohakash:v1:hide-videos';
  const mobileToggle = document.getElementById('mobile-hide-videos') as HTMLInputElement | null;

  function readPreference(): boolean {
    try {
      const raw = localStorage.getItem(KEY);
      return raw === null ? true : raw !== 'false';
    } catch {
      return true;
    }
  }

  function writePreference(value: boolean): void {
    try {
      localStorage.setItem(KEY, value ? 'true' : 'false');
    } catch {
      /* storage blocked */
    }
  }

  const initial = readPreference();
  if (mobileToggle) mobileToggle.checked = initial;

  mobileToggle?.addEventListener('change', () => {
    const value = mobileToggle.checked;
    writePreference(value);
    // Reload the page content if a script is listening for this change.
    window.dispatchEvent(new CustomEvent('mohakash:hide-videos-changed', { detail: { value } }));
  });
</script>

---
/**
 * Site header — wordmark and main navigation on the left, the "Hide videos"
 * switch on the right. The switch sits in the toolbar on the archive page
 * (`hideVideos="false"` keeps the right side empty) and moves into the
 * full-screen menu below 700px.
 */
import HideVideosSwitch from './HideVideosSwitch.astro';
import IconButton from './IconButton.astro';
import MobileMenu from './MobileMenu.astro';
import { NAV_LINKS, SITE } from '../lib/site';

interface Props {
  /** Current path, used to mark the active navigation item. */
  current: string;
  /** Render the header's "Hide videos" switch. Default: `true`. */
  hideVideos?: boolean;
}

const { current, hideVideos = true } = Astro.props;
const isCurrent = (href: string) =>
  href === '/' ? current === '/' : current === '/' + href || current.startsWith(href + '/');
---

<header class="site-header">
  <div class="site-header__inner">
    <div class="site-header__left">
      <a class="wordmark" href="/">{SITE.name}</a>

      <nav class="site-nav" aria-label="Main">
        {
          NAV_LINKS.map((link) => (
            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="site-header__right">
      {hideVideos && <HideVideosSwitch id="header-hide-videos" />}
      <IconButton
        label="Open menu"
        icon="menu"
        id="menu-button"
        class="site-header__menu-button"
        expanded={false}
      />
    </div>
  </div>
</header>

<MobileMenu current={current} />

<script>
  import { readHideVideos, writeHideVideos } from '../lib/preferences';

  // Keep every copy of the "Hide videos" switch (header, archive toolbar,
  // mobile menu) in sync with the stored preference.
  const toggles = [...document.querySelectorAll<HTMLInputElement>('input[data-hide-videos-toggle]')];

  function syncAll(value: boolean): void {
    for (const toggle of toggles) toggle.checked = value;
  }

  syncAll(readHideVideos());

  for (const toggle of toggles) {
    toggle.addEventListener('change', () => {
      const value = toggle.checked;
      writeHideVideos(value);
      syncAll(value);
      window.dispatchEvent(new CustomEvent('mohakash:hide-videos-changed', { detail: { value } }));
    });
  }

  // Sync when the preference changes in another tab or another place.
  window.addEventListener('mohakash:hide-videos-changed', (event) => {
    const value = (event as CustomEvent).detail?.value;
    if (typeof value === 'boolean') syncAll(value);
  });
</script>

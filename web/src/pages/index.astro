---
import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/Banner.astro';
import MediaFrame from '../components/MediaFrame.astro';
import Skeleton from '../components/Skeleton.astro';
import { SITE } from '../lib/site';
---

<BaseLayout
  title={`${SITE.name} · Astronomy Picture of the Day`}
  description="Today's Astronomy Picture of the Day, read straight from the public JSON API. No accounts, no tracking."
>
  <div class="page page--today" id="today-view">
    <Banner id="today-banner" actionLabel="Retry" />

    <section id="today-loading" aria-busy="true" aria-label="Loading today's picture">
      <Skeleton variant="block" height="auto" class="skeleton--hero" />
      <div class="stack-sm" style="margin-top: 24px;">
        <Skeleton width="30%" />
        <Skeleton variant="title" width="70%" />
      </div>
      <div class="stack-sm" style="margin-top: 24px;">
        <Skeleton width="100%" />
        <Skeleton width="90%" />
      </div>
    </section>

    <section id="today-content" hidden>
      <MediaFrame ratio="hero" id="today-frame" loading="eager" />

      <div class="entry-meta" style="margin-top: 20px;">
        <p class="entry-meta__line" id="today-date"></p>
        <h1 class="page-title" id="today-title"></h1>
        <p class="caption" id="today-sync"></p>
      </div>

      <div class="actions" id="today-actions" style="margin-top: 20px;"></div>
      <p class="media-note" id="today-media-note" hidden></p>

      <div class="prose" id="today-explanation" style="margin-top: 28px;"></div>
    </section>

    <div id="today-error" hidden></div>
  </div>
</BaseLayout>

<script src="../scripts/today.ts"></script>

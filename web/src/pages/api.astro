---
import BaseLayout from '../layouts/BaseLayout.astro';
import Chip from '../components/Chip.astro';
import SegmentedControl from '../components/SegmentedControl.astro';
import { SITE } from '../lib/site';

const fields = [
  { name: 'date', type: 'string', description: 'Publication date, YYYY-MM-DD.' },
  { name: 'title', type: 'string', description: 'Entry title.' },
  { name: 'explanation', type: 'string', description: 'Full text of the explanation.' },
  { name: 'media_type', type: 'string', description: 'image, video or other.' },
  { name: 'image_url', type: 'string | null', description: 'Direct HTTPS image link.' },
  { name: 'hd_image_url', type: 'string | null', description: 'Larger image, when available.' },
  { name: 'thumbnail_url', type: 'string | null', description: 'Small preview, when available.' },
  { name: 'apod_url', type: 'string', description: 'Original APOD page.' },
  { name: 'copyright', type: 'string | null', description: 'Creator credit as supplied.' },
  { name: 'credit', type: 'string | null', description: 'Creator credit as supplied.' },
  { name: 'alt_text', type: 'string | null', description: 'Only when supplied by the source.' },
  { name: 'source', type: 'string', description: 'Always the original provider name.' },
  { name: 'updated_at', type: 'string', description: 'ISO-8601 timestamp of the last change.' },
];

const endpoints = [
  { path: 'latest.json', description: 'Newest record plus sync metadata.' },
  { path: 'archive-index.json', description: 'Compact index of every entry, newest first. No explanations.' },
  { path: 'archive/YYYY.json', description: 'Full records for one calendar year.' },
  { path: 'status.json', description: 'Schema version, last sync, latest date, record count, source status.' },
  { path: '/feed.xml', description: 'RSS 2.0 feed of the latest 30 entries.' },
];
---

<BaseLayout
  title="API · Mohakash"
  description="A free, static JSON API for the Astronomy Picture of the Day. No key, no sign-up, no image files hosted."
>
  <div class="page page--tight">
    <div class="stack-sm" style="max-width: 68ch;">
      <h1 class="page-title">API</h1>
      <p class="page-lead">
        A free, static JSON API. No key, no sign-up. Responses carry metadata and links to the original image
        files; no image binaries are hosted by this project.
      </p>
    </div>

    <section class="section" aria-labelledby="base">
      <h2 class="section-title" id="base">Base URL</h2>
      <div class="base-cards">
        <div class="base-card">
          <div class="base-card__label">Same origin (this website)</div>
          <code>{SITE.sameOriginApiBase}</code>
        </div>
        <div class="base-card">
          <div class="base-card__label">Direct (GitHub Pages)</div>
          <code>{SITE.publicApiBase}</code>
        </div>
      </div>
      <p class="caption" id="api-status">Service status: loading…</p>
    </section>

    <section class="section" aria-labelledby="eps">
      <h2 class="section-title" id="eps">Endpoints</h2>
      <div class="def-list">
        {
          endpoints.map((endpoint) => (
            <div class="def-row">
              <code class="def-row__name">{endpoint.path}</code>
              <span class="def-row__desc">{endpoint.description}</span>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section" aria-labelledby="fields">
      <h2 class="section-title" id="fields">Record fields</h2>
      <div class="field-table-wrap">
        <table class="field-table">
          <caption>Every field of a single APOD record.</caption>
          <thead>
            <tr>
              <th scope="col">Field</th>
              <th scope="col">Type</th>
              <th scope="col">Description</th>
            </tr>
          </thead>
          <tbody>
            {
              fields.map((field) => (
                <tr>
                  <td><code>{field.name}</code></td>
                  <td class="field-table__type">{field.type}</td>
                  <td>
                    {field.description}
                    {field.name === 'media_type' && (
                      <span class="chip-row">
                        <Chip label="image" />
                        <Chip label="video" />
                        <Chip label="other" />
                      </span>
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="section" aria-labelledby="ex">
      <h2 class="section-title" id="ex">Examples</h2>
      <SegmentedControl
        id="example-base"
        label="Example base URL"
        value="same-origin"
        segments={[
          { value: 'same-origin', label: 'Same origin' },
          { value: 'github-pages', label: 'GitHub Pages' },
        ]}
      />
      <div class="example-label">Latest record</div>
      <pre class="code-block" data-base="const res = await fetch('{BASE}latest.json');
const latest = await res.json();
console.log(latest.title, latest.date);"></pre>
      <div class="example-label">One year of records</div>
      <pre class="code-block" data-base="curl {BASE}archive/2026.json"></pre>
    </section>

    <section class="section" aria-labelledby="notes" style="max-width: 68ch;">
      <h2 class="section-title" id="notes">Good to know</h2>
      <p class="page-lead" style="font-size: 15px;">
        Latest and status files are refreshed twice a day and cached briefly, so they never stay stale
        indefinitely. Yearly files are cached longer because they rarely change. Image rights stay with their
        creators: keep the credit when you reuse an entry. <a href="/rights">Content rights</a>
      </p>
      <p class="muted-block">
        The API only publishes metadata and links. The pictures themselves are served by the original source, so
        no image binaries are hosted by this project.
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  import { fetchStatus } from '../lib/api';
  import { formatDate, formatSyncedAgo } from '../lib/format';
  import { PUBLIC_API_BASE, SAME_ORIGIN_API_BASE } from '../lib/site.generated';

  const bases: Record<string, string> = {
    'same-origin': SAME_ORIGIN_API_BASE,
    'github-pages': PUBLIC_API_BASE,
  };

  const blocks = Array.from(document.querySelectorAll<HTMLPreElement>('pre.code-block[data-base]'));
  const options = Array.from(document.querySelectorAll<HTMLButtonElement>('.segmented__option'));

  function applyBase(key: string): void {
    const base = bases[key] ?? bases['same-origin'];
    for (const block of blocks) {
      const template = block.dataset.base ?? '';
      block.textContent = template.replace('{BASE}', base);
    }
    for (const option of options) {
      option.setAttribute('aria-pressed', String(option.dataset.segmentValue === key));
    }
  }

  for (const option of options) {
    option.addEventListener('click', () => {
      const value = option.dataset.segmentValue;
      if (!value) return;
      applyBase(value);
    });
  }

  applyBase('same-origin');

  const statusLine = document.getElementById('api-status');
  if (statusLine) {
    fetchStatus()
      .then((status) => {
        const synced = formatSyncedAgo(status.last_successful_sync);
        const from = formatDate(status.archive_start_date);
        const to = formatDate(status.archive_end_date);
        statusLine.textContent = `Service status: ${status.source_status}. ${synced}. ${status.record_count} records, ${from} to ${to}.`;
      })
      .catch(() => {
        statusLine.textContent = 'Service status: unavailable right now.';
      });
  }
</script>

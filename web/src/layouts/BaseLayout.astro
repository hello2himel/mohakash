---
/**
 * Base layout — document shell, fonts, header and footer.
 *
 * `variant="app"` is used by the three fixed-viewport pages (Today, Archive,
 * Entry): the body is a 56px / 1fr / 40px grid and nothing scrolls on a
 * desktop viewport. `variant="doc"` is the normal scrolling shell used by the
 * About, API, Rights and 404 pages.
 */
import '../styles/tokens.css';
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  /** Full document title. */
  title: string;
  description: string;
  /** `app` = fixed desktop viewport, `doc` = scrolling document. */
  variant?: 'app' | 'doc';
  /** Class of the `<main>` element on app pages. */
  mainClass?: string;
  /** Render the header's "Hide videos" switch. */
  hideVideos?: boolean;
}

const {
  title,
  description,
  variant = 'doc',
  mainClass = 'app-main',
  hideVideos = false,
} = Astro.props;
const current = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0b0d12" />
    <!-- The browser chrome colour mirrors --bg; it cannot read a CSS variable. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Mohakash" href="/feed.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:wght@500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class:list={['shell', variant === 'app' ? 'shell--app' : 'shell--doc']}>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader current={current} hideVideos={hideVideos} />
    <main class={variant === 'app' ? mainClass : 'doc-main'} id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

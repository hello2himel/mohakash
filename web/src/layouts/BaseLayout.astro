---
/**
 * Base layout — document shell, fonts, header and footer.
 *
 * Every page uses the same fixed-viewport shell: the header and footer stay
 * visible and only `<main>` scrolls. `variant="app"` is used by Today,
 * Archive and Entry for their fixed, no-scroll desktop layout; `variant="doc"`
 * is used by the scrolling About, API, Rights and 404 pages.
 */
import '../styles/tokens.css';
import '../styles/global.css';
import 'remixicon/fonts/remixicon.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import DonatePrompt from '../components/DonatePrompt.astro';
import { SITE } from '../lib/site';

interface Props {
  /** Full document title. */
  title: string;
  description: string;
  /** `app` = fixed desktop viewport, `doc` = scrolling document. */
  variant?: 'app' | 'doc';
  /** Class of the `<main>` element on app pages. */
  mainClass?: string;
  /** Render the header's "Hide videos" switch. */
  hideVideos?: boolean;
}

const {
  title,
  description,
  variant = 'doc',
  mainClass = 'app-main',
  hideVideos = false,
} = Astro.props;
const current = Astro.url.pathname;
const canonical = new URL(Astro.url.pathname, SITE.websiteUrl).toString();
const ogImage = new URL('/og-image.png', SITE.websiteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <!-- Brand Deep Space; visually matches the page background. -->
    <meta name="theme-color" content="#0B1020" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="mohakash" href="/feed.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="mohakash" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="mohakash — daily astronomy picture" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:wght@500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class:list={['shell', variant === 'app' ? 'shell--app' : 'shell--doc']}>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader current={current} hideVideos={hideVideos} />
    <main class={variant === 'app' ? mainClass : 'doc-main'} id="main">
      <slot />
    </main>
    <SiteFooter />
    <DonatePrompt />
  </body>
</html>

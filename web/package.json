{
  "name": "mohakash-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mohakash website \u2014 a static Astro front-end for the Astronomy Picture of the Day JSON API.",
  "scripts": {
    "generate:site": "node scripts/generate-site-config.mjs",
    "predev": "npm run generate:site",
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "npm run generate:site",
    "build": "astro build",
    "pretest": "npm run generate:site",
    "test": "vitest run",
    "test:watch": "vitest",
    "precheck": "npm run generate:site",
    "check": "astro check"
  },
  "dependencies": {
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^24.19.2",
    "smol-toml": "^1.9.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

# Copy to android/keystore.properties for local release builds.
#
# The real file is git-ignored. Back up both the keystore and this password
# file somewhere safe: losing them means you can no longer publish updates to
# an existing Play listing. Never email or commit either file.
#
# storeFile may be absolute or relative to the android/ directory.
storeFile=keystore/mohakash-release.jks
storePassword=replace-with-a-long-random-password
keyAlias=mohakash
keyPassword=replace-with-the-same-password

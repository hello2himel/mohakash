<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="database"
            path="mohakash.db" />
        <include
            domain="database"
            path="mohakash.db-wal" />
        <include
            domain="database"
            path="mohakash.db-shm" />
        <include
            domain="file"
            path="wallpaper/" />
        <include
            domain="file"
            path="datastore/mohakash_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="database"
            path="mohakash.db" />
        <include
            domain="database"
            path="mohakash.db-wal" />
        <include
            domain="database"
            path="mohakash.db-shm" />
        <include
            domain="file"
            path="wallpaper/" />
        <include
            domain="file"
            path="datastore/mohakash_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
